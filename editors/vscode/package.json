{
  "name": "corin-lang",
  "displayName": "Corin Language Support",
  "description": "Language support for Corin programming language",
  "version": "1.0.0-beta.8",
  "publisher": "corin-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/velo4705/corin-lang"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "corin",
    "programming language",
    "syntax highlighting"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "corin",
        "aliases": [
          "Corin",
          "corin"
        ],
        "extensions": [
          ".crn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "corin",
        "scopeName": "source.crn",
        "path": "./syntaxes/corin.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "corin"
      }
    ],
    "debuggers": [
      {
        "type": "corin",
        "label": "Corin Debug",
        "program": "./corin-debug",
        "runtime": "node",
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to a Corin file.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically stop after launch.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "corin",
            "request": "launch",
            "name": "Debug Corin Program",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Corin: Launch",
            "description": "A new configuration for debugging a Corin program",
            "body": {
              "type": "corin",
              "request": "launch",
              "name": "Debug Corin Program",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Corin",
      "properties": {
        "corin.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Language Server Protocol support"
        },
        "corin.lsp.path": {
          "type": "string",
          "default": "/usr/local/bin/corin-lsp",
          "description": "Path to corin-lsp executable"
        },
        "corin.debug.path": {
          "type": "string",
          "default": "corin-debug",
          "description": "Path to corin-debug executable"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  }
}
